{
  "version": 2,
  "installCommand": "npm install && npm --prefix server install && npm --prefix react-dashboard install",
  "buildCommand": "npm --prefix react-dashboard run build",
  "outputDirectory": "react-dashboard/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
