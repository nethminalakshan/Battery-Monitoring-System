{
  "version": 2,
  "installCommand": "npm --prefix server ci && npm --prefix react-dashboard ci",
  "buildCommand": "npm --prefix react-dashboard run build",
  "outputDirectory": "react-dashboard/dist",
  "functions": {
    "server/api/index.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
